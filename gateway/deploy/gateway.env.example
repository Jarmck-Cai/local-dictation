# Qingshu (Local Dictation) Gateway Server Environment Template
# Copy to /etc/local-dictation-gateway/gateway.env on the VPS with chmod 0600.
# NEVER commit real API keys or device tokens to Git.

GATEWAY_BIND_ADDR=127.0.0.1:8787
GATEWAY_DB_PATH=/var/lib/local-dictation-gateway/gateway.db

# Comma-separated named device tokens (`<device_label>=<secret_token>`).
# Each token must be at least 12 printable ASCII characters; revoke a lost laptop
# by removing only its entry and restarting `local-dictation-gateway`.
GATEWAY_AUTH_TOKENS=desktop=qsgw_replace_with_random_token_1,laptop=qsgw_replace_with_random_token_2

# Upstream ASR & formatting keys (stored ONLY on the VPS, never on client devices)
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-transcribe
# Optional. Defaults to gpt-live-transcribe when omitted. Set an empty value
# to serve the existing file-upload route only.
OPENAI_REALTIME_ASR_MODEL=gpt-live-transcribe

ANTHROPIC_API_KEY=
ANTHROPIC_CLEANUP_MODEL=claude-haiku-5-5

# Optional resource & timeout bounds
GATEWAY_MAX_AUDIO_BYTES=16777216
GATEWAY_ASR_TIMEOUT_MS=20000
GATEWAY_CLEANUP_TIMEOUT_MS=8000
RUST_LOG=info
